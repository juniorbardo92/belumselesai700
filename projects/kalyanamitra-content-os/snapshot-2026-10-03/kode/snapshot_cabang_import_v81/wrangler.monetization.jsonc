{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "umkm-monetization-engine",
  "main": "src/monetization-worker-v14.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "go.umkmnaikkelas.id",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "services": [
    {
      "binding": "CONTENT_OS",
      "service": "umkm-content-os"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "umkm-content-os-db",
      "database_id": "REPLACE_RESOURCE_ID",
      "migrations_dir": "database/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MONETIZATION_QUEUE",
        "queue": "umkm-monetization-ops"
      }
    ],
    "consumers": [
      {
        "queue": "umkm-monetization-ops",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
