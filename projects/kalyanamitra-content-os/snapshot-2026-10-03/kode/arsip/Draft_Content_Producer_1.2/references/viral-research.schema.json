{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruangkalyanamitra.local/schemas/kalyanamitra-viral-research.v1.json",
  "title": "Ruang Kalyanamitra Viral Research Pack v1",
  "description": "Manual planning input containing observed and scored time-sensitive content opportunities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_id",
    "generated_at",
    "research_period",
    "region",
    "platform",
    "language",
    "timezone",
    "research_mode",
    "query_summary",
    "research_risk_flags",
    "human_review_required",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "kalyanamitra-viral-research.v1"},
    "research_id": {
      "type": "string",
      "pattern": "^rk-viral-[0-9]{8}-[0-9]{8}$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "research_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      }
    },
    "region": {"const": "Indonesia"},
    "platform": {"const": "threads"},
    "language": {"const": "id-ID"},
    "timezone": {"const": "Asia/Jakarta"},
    "research_mode": {
      "type": "string",
      "enum": ["web-researched", "user-supplied-only", "mixed"]
    },
    "query_summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "research_risk_flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100},
      "contains": {"const": "do-not-treat-as-fact"},
      "minContains": 1
    },
    "human_review_required": {"const": true},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "title",
        "url",
        "observed_at",
        "observed_signal",
        "metric_value",
        "source_status",
        "privacy_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^trend-src-[a-z0-9][a-z0-9-]{2,63}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "threads-topic",
            "threads-insights",
            "google-trends",
            "official-newsroom",
            "official-agency",
            "primary-reporting",
            "audience-signal",
            "creator-observation",
            "user-provided"
          ]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": ["string", "null"], "format": "uri", "maxLength": 1000},
        "observed_at": {"type": "string", "format": "date-time"},
        "observed_signal": {"type": "string", "minLength": 1, "maxLength": 1000},
        "metric_value": {"type": ["string", "null"], "maxLength": 120},
        "source_status": {
          "type": "string",
          "enum": ["directly-observed", "user-supplied-needs-review"]
        },
        "privacy_status": {
          "type": "string",
          "enum": [
            "public-source",
            "anonymized-private-input",
            "user-owned",
            "needs-review"
          ]
        }
      }
    },
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recency",
        "velocity",
        "audience_fit",
        "dharma_bridge",
        "source_quality",
        "novelty",
        "risk_penalty"
      ],
      "properties": {
        "recency": {"type": "integer", "minimum": 0, "maximum": 5},
        "velocity": {"type": "integer", "minimum": 0, "maximum": 5},
        "audience_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "dharma_bridge": {"type": "integer", "minimum": 0, "maximum": 5},
        "source_quality": {"type": "integer", "minimum": 0, "maximum": 5},
        "novelty": {"type": "integer", "minimum": 0, "maximum": 5},
        "risk_penalty": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trend_id",
        "topic",
        "summary",
        "observed_at",
        "expires_at",
        "audience_problem",
        "possible_dharma_bridge",
        "tradition_hint",
        "time_sensitive",
        "sources",
        "score_components",
        "viral_opportunity_score",
        "risk_level",
        "risk_notes",
        "decision",
        "usage",
        "review_status",
        "reviewed_at",
        "reviewed_by",
        "status",
        "tags"
      ],
      "properties": {
        "trend_id": {
          "type": "string",
          "pattern": "^trend-[a-z0-9][a-z0-9-]{2,63}$"
        },
        "topic": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "audience_problem": {"type": "string", "minLength": 1, "maxLength": 600},
        "possible_dharma_bridge": {"type": "string", "minLength": 1, "maxLength": 600},
        "tradition_hint": {
          "type": "string",
          "enum": [
            "theravada",
            "mahayana",
            "vajrayana",
            "cross-tradition",
            "general-buddhist",
            "unknown"
          ]
        },
        "time_sensitive": {"const": true},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/source"}
        },
        "score_components": {"$ref": "#/$defs/score_components"},
        "viral_opportunity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "risk_notes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "decision": {
          "type": "string",
          "enum": ["use-now", "monitor", "reject"]
        },
        "usage": {"const": "inspiration-only"},
        "review_status": {
          "type": "string",
          "enum": ["needs-review", "reviewed-by-human"]
        },
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 160},
        "status": {
          "type": "string",
          "enum": ["active", "expired"]
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 60}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_status": {"const": "reviewed-by-human"}},
            "required": ["review_status"]
          },
          "then": {
            "properties": {
              "reviewed_at": {"type": "string", "format": "date-time"},
              "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        }
      ]
    }
  }
}
