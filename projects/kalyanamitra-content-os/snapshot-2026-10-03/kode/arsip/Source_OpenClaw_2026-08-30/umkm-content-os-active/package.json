{
  "name": "@umkm-naik-kelas/openclaw-content-os",
  "version": "1.4.0",
  "description": "UMKM Content OS research and official Meta Threads operations with a guarded, persistent auto-reply policy.",
  "type": "module",
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "AUTO_REPLY_PROMPT.txt"
  ],
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/meta-threads.ts --bundle --platform=node --format=esm --target=node22 --external:openclaw --external:typebox --outdir=dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify": "npm test"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17 <2027"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
